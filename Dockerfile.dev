# ============================================================
# Development Dockerfile
# Runs Vite dev server with hot module replacement (HMR)
# Source code is mounted as a volume, not copied into image
# ============================================================

FROM node:20-alpine

WORKDIR /app

# Install dependencies (cached layer)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Do NOT copy source here -- it will be volume-mounted at runtime
# to enable hot reload

# Vite dev server port
EXPOSE 3000

# Allow overriding host/port via environment
ENV VITE_DEV_SERVER_HOST=0.0.0.0
ENV VITE_DEV_ALLOWED_HOSTS=all

CMD ["npm", "run", "dev"]
